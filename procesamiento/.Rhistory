# CARGA DE BASE (HIPO)
base_2023 <- read_delim(
"../input/data/Latinobarometro_2023_Argentina_Csv_esp_v1.csv",
delim = ";"
)
datos_satisfaccion_democratica <- base_2023 %>%
select(
EDAD,
SEXO,
S2,
S11,
S12,
P11STGBS.A
) %>%
mutate(
# limpieza edad
EDAD = ifelse(EDAD <= 0, NA, EDAD),
# limpieza sexo
SEXO = ifelse(SEXO == 0, NA, SEXO),
# clase social subjetiva
S2 = ifelse(S2 < 0 | S2 %in% c(0,8), NA, S2),
# nivel educativo encuestado
S11 = ifelse(S11 < 0 | S11 %in% c(96,97,98,99), NA, S11),
# nivel educativo padres
S12 = ifelse(S12 < 0 | S12 %in% c(96,97,98,99), NA, S12),
# satisfacción democracia
satisfaccion_democracia = case_when(
P11STGBS.A %in% c(-1, -2, 0, 8) ~ NA_real_,
TRUE ~ P11STGBS.A
)
) %>%
rename(
edad = EDAD,
sexo = SEXO,
clase_social = S2,
nivel_educativo = S11,
nivel_padres = S12
) %>%
mutate(
satisfaccion_democracia = factor(
satisfaccion_democracia,
ordered = TRUE
),
indice_capital_sociocultural =
rowMeans(
select(., clase_social, nivel_educativo, nivel_padres),
na.rm = TRUE
)
) %>%
select(-P11STGBS.A) %>%
drop_na(satisfaccion_democracia)
#TABLA DESCRIPTIVA (numéricas)
