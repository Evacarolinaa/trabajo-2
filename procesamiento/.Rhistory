datos_satisfaccion_democratica <- base_2023 %>%
select(EDAD, SEXO, S10, S11, S12, S21A, S21B, P11STGBS.A) %>%
mutate(
# limpieza edad
EDAD = ifelse(EDAD <= 0, NA, EDAD),
# limpieza sexo
SEXO = ifelse(SEXO == 0, NA, SEXO),
# educación propia
S10 = ifelse(S10 %in% c(-1, 0, 96, 97, 98), NA, S10),
S11 = ifelse(S11 %in% c(-1, 0, 96, 97, 98), NA, S11),
# educación padres
S12 = ifelse(S12 %in% c(-1, 0, 96, 97, 98), NA, S12),
# educación jefe hogar
S21A = ifelse(S21A %in% c(-1, 0, 96, 97, 98), NA, S21A),
S21B = ifelse(S21B %in% c(-1, 0, 96, 97, 98), NA, S21B),
# satisfacción democracia
satisfaccion_democracia = case_when(
P11STGBS.A %in% c(-1, -2, 0, 8) ~ NA_real_,
TRUE ~ P11STGBS.A
)
) %>%
rename(
edad = EDAD,
sexo = SEXO,
edad_fin_estudios = S10,
nivel_educativo = S11,
nivel_padres = S12,
edad_fin_estudios_jefe = S21A,
nivel_educativo_jefe = S21B
) %>%
mutate(
satisfaccion_democracia = factor(
satisfaccion_democracia,
ordered = TRUE
)
) %>%
select(-P11STGBS.A) %>%
drop_na(satisfaccion_democracia)
names(datos_satisfaccion_democratica)
