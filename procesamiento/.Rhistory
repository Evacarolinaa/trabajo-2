base_clean <- base_2023 %>%
select(EDAD, SEXO, S10, S11, P11STGBS.A) %>%
mutate(
S10 = ifelse(S10 < 0, NA, S10),
P11STGBS.A = ifelse(P11STGBS.A < 0, NA, P11STGBS.A)
) %>%
drop_na() %>%
rename(
edad = EDAD,
sexo = SEXO,
edad_fin_estudios = S10,
nivel_educativo = S11,
satisfaccion_democracia = P11STGBS.A
)
#TABLA DESCRIPTIVA (numéricas)
tabla_desc <- datos_satisfaccion_democratica %>%
summarise(
edad_media = mean(edad),
edad_mediana = median(edad),
edad_sd = sd(edad),
edad_fin_estudios_media = mean(edad_fin_estudios),
edad_fin_estudios_mediana = median(edad_fin_estudios),
edad_fin_estudios_sd = sd(edad_fin_estudios)
)
datos_satisfaccion_democratica <- base_2023 %>%
select(EDAD, SEXO, S10, S11, P11STGBS.A) %>%
mutate(
# EDAD
EDAD = ifelse(EDAD <= 0, NA, EDAD),
# SEXO
SEXO = ifelse(SEXO %in% c(0), NA, SEXO),
# S10 (edad fin estudios)
S10 = ifelse(S10 %in% c(0, 96, 97, 98) | S10 < 0, NA, S10),
# S11 (educación)
S11 = ifelse(S11 %in% c(0), NA, S11),
# SATISFACCIÓN DEMOCRACIA
P11STGBS.A = ifelse(P11STGBS.A %in% c(0, 8) | P11STGBS.A < 0, NA, P11STGBS.A)
) %>%
drop_na() %>%
rename(
edad = EDAD,
sexo = SEXO,
edad_fin_estudios = S10,
nivel_educativo = S11,
satisfaccion_democracia = P11STGBS.A
)
# =========================
# LIMPIEZA COMPLETA
# =========================
datos_satisfaccion_democratica <- base_2023 %>%
select(EDAD, SEXO, S10, S11, P11STGBS.A) %>%
mutate(
# EDAD
EDAD = ifelse(EDAD <= 0, NA, EDAD),
# SEXO
SEXO = ifelse(SEXO %in% c(0), NA, SEXO),
# S10 (edad fin estudios)
S10 = ifelse(S10 %in% c(0, 96, 97, 98) | S10 < 0, NA, S10),
# S11 (educación)
S11 = ifelse(S11 %in% c(0), NA, S11),
# SATISFACCIÓN DEMOCRACIA
P11STGBS.A = ifelse(P11STGBS.A %in% c(0, 8) | P11STGBS.A < 0, NA, P11STGBS.A)
) %>%
drop_na() %>%
rename(
edad = EDAD,
sexo = SEXO,
edad_fin_estudios = S10,
nivel_educativo = S11,
satisfaccion_democracia = P11STGBS.A
)
#RENOMBRAR VARIABLES
base_clean <- base_clean %>%
rename(
edad = EDAD,
sexo = SEXO,
edad_fin_estudios = S10,
nivel_educativo = S11
)
# =========================
# LIMPIEZA COMPLETA
# =========================
datos_satisfaccion_democratica <- base_2023 %>%
select(EDAD, SEXO, S10, S11, P11STGBS.A) %>%
mutate(
EDAD = ifelse(EDAD <= 0, NA, EDAD),
SEXO = ifelse(SEXO == 0, NA, SEXO),
S10 = ifelse(S10 %in% c(0, 96, 97, 98) | S10 < 0, NA, S10),
S11 = ifelse(S11 == 0, NA, S11),
P11STGBS.A = ifelse(P11STGBS.A %in% c(0, 8) | P11STGBS.A < 0, NA, P11STGBS.A)
) %>%
drop_na() %>%
rename(
edad = EDAD,
sexo = SEXO,
edad_fin_estudios = S10,
nivel_educativo = S11,
satisfaccion_democracia = P11STGBS.A
)
View(datos_satisfaccion_democratica)
#TABLA DESCRIPTIVA (numéricas)
tabla_desc <- datos_satisfaccion_democratica %>%
summarise(
edad_media = mean(edad),
edad_mediana = median(edad),
edad_sd = sd(edad),
edad_fin_estudios_media = mean(edad_fin_estudios),
edad_fin_estudios_mediana = median(edad_fin_estudios),
edad_fin_estudios_sd = sd(edad_fin_estudios)
)
tabla_desc
# =========================
# TABLAS DE FRECUENCIA CON PORCENTAJES
# =========================
# =========================
# LIBRERÍAS
# =========================
library(dplyr)
library(knitr)
library(kableExtra)
# =========================
# TABLA: SEXO
# =========================
tab_sexo <- datos_satisfaccion_democratica %>%
count(sexo) %>%
mutate(porcentaje = round((n/sum(n))*100, 1))
kable(tab_sexo, caption = "Distribución por sexo") %>%
kable_styling(full_width = FALSE)
# =========================
# TABLA: NIVEL EDUCATIVO
# =========================
tab_educ <- datos_satisfaccion_democratica %>%
count(nivel_educativo) %>%
mutate(porcentaje = round((n/sum(n))*100, 1))
kable(tab_educ, caption = "Distribución nivel educativo") %>%
kable_styling(full_width = FALSE)
# =========================
# TABLA: SATISFACCIÓN DEMOCRACIA
# =========================
tab_sat <- datos_satisfaccion_democratica %>%
count(satisfaccion_democracia) %>%
mutate(porcentaje = round((n/sum(n))*100, 1))
kable(tab_sat, caption = "Satisfacción con la democracia") %>%
kable_styling(full_width = FALSE)
library(ggplot2)
# =========================
# GRÁFICO 1: EDAD
# =========================
ggplot(datos_satisfaccion_democratica, aes(x = edad)) +
geom_histogram(binwidth = 5, fill = "gray70", color = "black") +
labs(
title = "Distribución de la edad",
x = "Edad",
y = "Frecuencia"
) +
theme_minimal()
# =========================
# GRÁFICO 2: SATISFACCIÓN DEMOCRACIA
# =========================
ggplot(datos_satisfaccion_democratica, aes(x = satisfaccion_democracia)) +
geom_bar(fill = "gray70", color = "black") +
labs(
title = "Distribución de la satisfacción con la democracia",
x = "Nivel de satisfacción",
y = "Frecuencia"
) +
theme_minimal()
