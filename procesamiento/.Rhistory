#TABLA DESCRIPTIVA (numéricas)
tabla_desc <- datos_satisfaccion_democratica %>%
summarise(
edad_media = mean(edad),
edad_mediana = median(edad),
edad_sd = sd(edad),
edad_fin_estudios_media = mean(edad_fin_estudios),
edad_fin_estudios_mediana = median(edad_fin_estudios),
edad_fin_estudios_sd = sd(edad_fin_estudios)
)
tabla_desc
