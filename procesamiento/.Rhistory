# =========================
if (!require(pacman)) install.packages("pacman")
pacman::p_load(
tidyverse,   # incluye dplyr, ggplot2, readr
readr,
dplyr,
ggplot2,
janitor,
kableExtra
)
# CARGA DE BASE (HIPO)
base_2023 <- read_delim(
"../input/data/Latinobarometro_2023_Argentina_Csv_esp_v1.csv",
delim = ";"
)
# =========================
# LIMPIEZA COMPLETA
# =========================
datos_satisfaccion_democratica <- base_2023 %>%
select(EDAD, SEXO, S10, S11, P11STGBS.A) %>%
mutate(
EDAD = ifelse(EDAD <= 0, NA, EDAD),
SEXO = ifelse(SEXO == 0, NA, SEXO),
S10 = ifelse(S10 %in% c(0, 96, 97, 98) | S10 < 0, NA, S10),
S11 = ifelse(S11 == 0, NA, S11),
P11STGBS.A = ifelse(P11STGBS.A %in% c(0, 8) | P11STGBS.A < 0, NA, P11STGBS.A)
) %>%
drop_na() %>%
rename(
edad = EDAD,
sexo = SEXO,
edad_fin_estudios = S10,
nivel_educativo = S11,
satisfaccion_democracia = P11STGBS.A
)
base_clean <- base_clean %>%
rename(
satisfaccion_democracia = sat_dem
)
#TABLA DESCRIPTIVA (numéricas)
tabla_desc <- datos_satisfaccion_democratica %>%
summarise(
edad_media = mean(EDAD),
edad_mediana = median(EDAD),
edad_sd = sd(EDAD),
edad_fin_estudios_media = mean(S10),
edad_fin_estudios_mediana = median(S10),
edad_fin_estudios_sd = sd(S10)
)
# =========================
# LIMPIEZA COMPLETA
# =========================
datos_satisfaccion_democratica <- base_2023 %>%
select(EDAD, SEXO, S10, S11, P11STGBS.A) %>%
mutate(
EDAD = ifelse(EDAD <= 0, NA, EDAD),
SEXO = ifelse(SEXO == 0, NA, SEXO),
S10 = ifelse(S10 %in% c(0, 96, 97, 98) | S10 < 0, NA, S10),
S11 = ifelse(S11 == 0, NA, S11),
P11STGBS.A = ifelse(P11STGBS.A %in% c(0, 8) | P11STGBS.A < 0, NA, P11STGBS.A)
) %>%
drop_na() %>%
rename(
edad = EDAD,
sexo = SEXO,
edad_fin_estudios = S10,
nivel_educativo = S11,
satisfaccion_democracia = P11STGBS.A
)
base_clean <- base_clean %>%
rename(
satisfaccion_democracia = sat_dem
)
