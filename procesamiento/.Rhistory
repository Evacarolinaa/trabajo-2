# CARGA DE BASE (HIPO)
base_2023 <- read_delim(
"../input/data/Latinobarometro_2023_Argentina_Csv_esp_v1.csv",
delim = ";"
)
datos_satisfaccion_democratica <- base_2023 %>%
select(EDAD, SEXO, S10, S11, P11STGBS.A) %>%
mutate(
EDAD = ifelse(EDAD <= 0, NA, EDAD),
SEXO = ifelse(SEXO == 0, NA, SEXO),
S10 = ifelse(S10 %in% c(0, 96, 97, 98) | S10 < 0, NA, S10),
S11 = ifelse(S11 == 0, NA, S11),
P11STGBS.A = ifelse(P11STGBS.A %in% c(0, 8) | P11STGBS.A < 0, NA, P11STGBS.A)
) %>%
drop_na() %>%
rename(
edad = EDAD,
sexo = SEXO,
edad_fin_estudios = S10,
nivel_educativo = S11,
satisfaccion_democracia = P11STGBS.A
)
base_clean <- base_clean %>%
rename(
satisfaccion_democracia = sat_dem
)
datos_satisfaccion_democratica <- base_2023 %>%
select(EDAD, SEXO, S10, S11, P11STGBS.A) %>%
mutate(
EDAD = ifelse(EDAD <= 0, NA, EDAD),
SEXO = ifelse(SEXO == 0, NA, SEXO),
S10 = ifelse(S10 %in% c(0, 96, 97, 98) | S10 < 0, NA, S10),
S11 = ifelse(S11 == 0, NA, S11),
P11STGBS.A = ifelse(P11STGBS.A %in% c(0, 8) | P11STGBS.A < 0, NA, P11STGBS.A)
) %>%
drop_na() %>%
rename(
edad = EDAD,
sexo = SEXO,
edad_fin_estudios = S10,
nivel_educativo = S11,
satisfaccion_democracia = P11STGBS.A
)
base_clean <- base_clean %>%
rename(
sat_dem  = satisfaccion_democracia
)
base_clean <- base_2023 %>%
select(EDAD, SEXO, S10, S11, P11STGBS.A) %>%
mutate(
satisfaccion_democracia = case_when(
P11STGBS.A %in% c(-1, -2, 0, 8) ~ NA_real_,
TRUE ~ P11STGBS.A
)
) %>%
drop_na(satisfaccion_democracia)
base_clean <- base_clean %>%
mutate(
satisfaccion_democracia = factor(satisfaccion_democracia, ordered = TRUE)
)
base_clean <- base_clean %>%
