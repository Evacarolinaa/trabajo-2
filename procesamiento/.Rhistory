# CARGA DE BASE (HIPO)
base_2023 <- read_delim(
"../input/data/Latinobarometro_2023_Argentina_Csv_esp_v1.csv",
delim = ";"
)
datos_satisfaccion_democratica <- base_2023 %>%
select(
EDAD,
SEXO,
S11,
P11STGBS.A
) %>%
mutate(
# limpieza edad
EDAD = ifelse(EDAD <= 0, NA, EDAD),
# limpieza sexo
SEXO = ifelse(SEXO == 0, NA, SEXO),
# nivel educativo
S11 = ifelse(
S11 < 0 | S11 %in% c(96,97,98,99),
NA,
S11
),
# satisfacción con la democracia
satisfaccion_democracia = case_when(
P11STGBS.A %in% c(-1,-2,0,8) ~ NA_real_,
TRUE ~ P11STGBS.A
)
) %>%
rename(
edad = EDAD,
sexo = SEXO,
nivel_educativo = S11
) %>%
mutate(
satisfaccion_democracia = factor(
satisfaccion_democracia,
ordered = TRUE
)
) %>%
select(
edad,
sexo,
nivel_educativo,
satisfaccion_democracia
) %>%
drop_na(satisfaccion_democracia)
datos_satisfaccion_democratica %>%
select(
edad,
nivel_educativo
) %>%
sjmisc::descr(
show = c(
"range",
"mean",
"sd",
"NA.prc",
"n"
)
) %>%
kable("markdown")
datos_satisfaccion_democratica %>%
mutate(
sexo = case_when(
sexo == 1 ~ "Hombre",
sexo == 2 ~ "Mujer"
)
) %>%
count(sexo) %>%
mutate(
porcentaje = round(n / sum(n) * 100, 1)
) %>%
knitr::kable()
datos_satisfaccion_democratica %>%
mutate(
satisfaccion_democracia = case_when(
satisfaccion_democracia == 1 ~ "Muy satisfecho",
satisfaccion_democracia == 2 ~ "Más bien satisfecho",
satisfaccion_democracia == 3 ~ "No muy satisfecho",
satisfaccion_democracia == 4 ~ "Nada satisfecho"
)
) %>%
count(satisfaccion_democracia) %>%
mutate(
porcentaje = round(n / sum(n) * 100, 1)
) %>%
knitr::kable()
#| fig-cap: "Distribución de la satisfacción con la democracia en Argentina (2023)"
datos_satisfaccion_democratica %>%
mutate(
satisfaccion_democracia = factor(
satisfaccion_democracia,
levels = c(1, 2, 3, 4),
labels = c(
"Muy satisfecho",
"Más bien satisfecho",
"No muy satisfecho",
"Nada satisfecho"
)
)
) %>%
ggplot(
aes(x = satisfaccion_democracia)
) +
geom_bar() +
labs(
x = "Nivel de satisfacción",
y = "Frecuencia"
) +
theme_minimal()
datos_satisfaccion_democratica %>%
mutate(
sexo = factor(
sexo,
levels = c(1, 2),
labels = c(
"Hombre",
"Mujer"
)
),
satisfaccion_democracia = factor(
satisfaccion_democracia,
levels = c(1, 2, 3, 4),
labels = c(
"Muy satisfecho",
"Más bien satisfecho",
"No muy satisfecho",
"Nada satisfecho"
)
)
) %>%
count(
sexo,
satisfaccion_democracia
) %>%
group_by(sexo) %>%
mutate(
porcentaje = round(
n / sum(n) * 100,
1
)
) %>%
knitr::kable(
col.names = c(
"Sexo",
"Satisfacción con la democracia",
"Frecuencia",
"Porcentaje"
),
caption = "Tabla 1. Distribución de la satisfacción con la democracia según sexo"
)
tabla_sexo <- datos_satisfaccion_democratica %>%
mutate(
sexo = factor(
sexo,
levels = c(1, 2),
labels = c(
"Hombre",
"Mujer"
)
),
satisfaccion_democracia = factor(
satisfaccion_democracia,
levels = c(1, 2, 3, 4),
labels = c(
"Muy satisfecho",
"Más bien satisfecho",
"No muy satisfecho",
"Nada satisfecho"
)
)
) %>%
select(
sexo,
satisfaccion_democracia
) %>%
table()
chisq.test(tabla_sexo)
ggplot(
datos_satisfaccion_democratica,
aes(
x = satisfaccion_democracia,
y = edad
)
) +
geom_boxplot() +
labs(
title = "Edad según satisfacción con la democracia",
x = "Nivel de satisfacción",
y = "Edad"
) +
theme_minimal()
kruskal.test(
edad ~ satisfaccion_democracia,
data = datos_satisfaccion_democratica
)
ggplot(
datos_satisfaccion_democratica,
aes(
x = satisfaccion_democracia,
y = nivel_educativo
)
) +
geom_boxplot() +
labs(
title = "Nivel educativo según satisfacción con la democracia",
x = "Nivel de satisfacción",
y = "Nivel educativo"
) +
theme_minimal()
kruskal.test(
nivel_educativo ~ satisfaccion_democracia,
data = datos_satisfaccion_democratica
)
datos_regresion <- base_2023 %>%
dplyr::select(
EDAD,
SEXO,
S11,
P11STGBS.A,
P15STGBS
) %>%
mutate(
edad = ifelse(EDAD <= 0, NA, EDAD),
sexo = case_when(
SEXO == 1 ~ "Hombre",
SEXO == 2 ~ "Mujer",
TRUE ~ NA_character_
),
nivel_educativo = case_when(
S11 < 0 ~ NA_real_,
S11 %in% c(96, 97, 98, 99) ~ NA_real_,
TRUE ~ as.numeric(S11)
),
satisfaccion_democracia = case_when(
P11STGBS.A %in% c(1, 2, 3, 4) ~ P11STGBS.A,
TRUE ~ NA_real_
),
aprobacion_presidencial = case_when(
P15STGBS == 1 ~ "Aprueba",
P15STGBS == 2 ~ "Desaprueba",
TRUE ~ NA_character_
)
) %>%
mutate(
satisfaccion_democracia = factor(
satisfaccion_democracia,
ordered = TRUE,
levels = c(1, 2, 3, 4),
labels = c(
"Muy satisfecho",
"Más bien satisfecho",
"No muy satisfecho",
"Nada satisfecho"
)
),
sexo = factor(sexo),
aprobacion_presidencial = factor(
aprobacion_presidencial,
levels = c(
"Aprueba",
"Desaprueba"
)
)
) %>%
tidyr::drop_na()
glimpse(datos_regresion)
library(MASS)
modelo_1 <- polr(
satisfaccion_democracia ~
sexo +
edad +
nivel_educativo,
data = datos_regresion,
Hess = TRUE
)
summary(modelo_1)
library(MASS)
modelo_2 <- polr(
satisfaccion_democracia ~
sexo +
edad +
nivel_educativo +
aprobacion_presidencial,
data = datos_regresion,
Hess = TRUE
)
summary(modelo_2)
datos_logit <- base_2023 %>%
dplyr::select(
EDAD,
SEXO,
S11,
P11STGBS.A,
P15STGBS
) %>%
mutate(
edad = ifelse(
EDAD <= 0,
NA,
EDAD
),
sexo = case_when(
SEXO == 1 ~ "Hombre",
SEXO == 2 ~ "Mujer",
TRUE ~ NA_character_
),
nivel_educativo = case_when(
S11 < 0 ~ NA_real_,
S11 %in% c(96, 97, 98, 99) ~ NA_real_,
TRUE ~ as.numeric(S11)
),
satisfaccion_binaria = case_when(
P11STGBS.A %in% c(1, 2) ~ 1,  # satisfecho
P11STGBS.A %in% c(3, 4) ~ 0,  # insatisfecho
TRUE ~ NA_real_
),
aprobacion_presidencial = case_when(
P15STGBS == 1 ~ "Aprueba",
P15STGBS == 2 ~ "Desaprueba",
TRUE ~ NA_character_
)
) %>%
mutate(
sexo = factor(sexo),
aprobacion_presidencial = factor(
aprobacion_presidencial,
levels = c(
"Aprueba",
"Desaprueba"
)
)
) %>%
tidyr::drop_na()
modelo_logit <- glm(
satisfaccion_binaria ~
sexo +
edad +
nivel_educativo +
aprobacion_presidencial,
data = datos_logit,
family = binomial(link = "logit")
)
summary(modelo_logit)
exp(coef(modelo_logit))
predicciones <- expand.grid(
aprobacion_presidencial = c(
"Aprueba",
"Desaprueba"
),
sexo = c(
"Hombre",
"Mujer"
)
)
predicciones$edad <- mean(datos_logit$edad)
predicciones$nivel_educativo <- mean(
datos_logit$nivel_educativo
)
predicciones$sexo <- factor(
predicciones$sexo,
levels = levels(datos_logit$sexo)
)
predicciones$aprobacion_presidencial <- factor(
predicciones$aprobacion_presidencial,
levels = levels(
datos_logit$aprobacion_presidencial
)
)
predicciones$probabilidad <- predict(
modelo_logit,
newdata = predicciones,
type = "response"
)
ggplot(
predicciones,
aes(
x = aprobacion_presidencial,
y = probabilidad,
fill = sexo
)
) +
geom_col(
position = "dodge"
) +
labs(
title = "Probabilidad predicha de satisfacción con la democracia",
x = "Aprobación presidencial",
y = "Probabilidad predicha",
fill = "Sexo"
) +
theme_minimal()
