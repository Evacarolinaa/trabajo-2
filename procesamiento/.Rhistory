datos_satisfaccion_democratica <- base_2023 %>%
select(EDAD, SEXO, S10, S11, S12, S21A, S21B, P11STGBS.A) %>%
mutate(
EDAD = ifelse(EDAD <= 0, NA, EDAD),
SEXO = ifelse(SEXO == 0, NA, SEXO),
S10 = ifelse(S10 %in% c(0, 96, 97, 98) | S10 < 0, NA, S10),
S11 = ifelse(S11 == 0, NA, S11),
P11STGBS.A = ifelse(P11STGBS.A %in% c(0, 8) | P11STGBS.A < 0, NA, P11STGBS.A)
) %>%
drop_na() %>%
rename(
edad = EDAD,
sexo = SEXO,
edad_fin_estudios = S10,
nivel_educativo = S11,
nivel_padres = S12,
nivel_jefe_hogar = S21A, S21B,
satisfaccion_democracia = P11STGBS.A
)
datos_satisfaccion_democratica <- base_2023 %>%
select(EDAD, SEXO, S10, S11, S12, S21A, S21B, P11STGBS.A) %>%
mutate(
EDAD = ifelse(EDAD <= 0, NA, EDAD),
SEXO = ifelse(SEXO == 0, NA, SEXO),
S10 = ifelse(S10 %in% c(0, 96, 97, 98) | S10 < 0, NA, S10),
S11 = ifelse(S11 == 0, NA, S11),
S12 = ifelse(S12 == 0, NA, S12),
S21A = ifelse(S21A %in% c(0, 96, 97, 98) | S21A < 0, NA, S21A),
S21B = ifelse(S21B == 0, NA, S21B),
P11STGBS.A = ifelse(P11STGBS.A %in% c(0, 8) | P11STGBS.A < 0, NA, P11STGBS.A)
) %>%
drop_na() %>%
rename(
edad = EDAD,
sexo = SEXO,
edad_fin_estudios = S10,
nivel_educativo = S11,
nivel_padres = S12,
edad_fin_estudios_jefe = S21A,
nivel_educativo_jefe = S21B,
satisfaccion_democracia = P11STGBS.A
)
base_clean <- base_2023 %>%
select(EDAD, SEXO, S10, S11, S12, S21A, S21B, P11STGBS.A) %>%
mutate(
satisfaccion_democracia = case_when(
P11STGBS.A %in% c(-1, -2, 0, 8) ~ NA_real_,
TRUE ~ P11STGBS.A
)
) %>%
drop_na(satisfaccion_democracia)
base_clean <- base_clean %>%
mutate(
satisfaccion_democracia = factor(satisfaccion_democracia, ordered = TRUE)
)
base_clean <- base_clean %>%
select(-P11STGBS.A)
datos_satisfaccion_democratica <- base_clean
datos_satisfaccion_democratica <- datos_satisfaccion_democratica %>%
mutate(
S10 = ifelse(S10 < 0, NA, S10)
) %>%
drop_na()
#TABLA DESCRIPTIVA (numéricas)
library(sjmisc)
datos_satisfaccion_democratica %>%
select(
edad,
edad_fin_estudios,
nivel_educativo,
nivel_padres,
edad_fin_estudios_jefe,
nivel_educativo_jefe
) %>%
sjmisc::descr(
show = c("label", "range", "mean", "sd", "NA.prc", "n")
) %>%
kable("markdown")
