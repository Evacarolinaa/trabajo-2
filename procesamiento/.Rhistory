library(dplyr)
library(knitr)
library(kableExtra)
# Sexo
tab_sexo <- datos_satisfaccion_democratica %>%
count(sexo) %>%
mutate(porcentaje = round((n/sum(n))*100, 1))
# =========================
# LIBRERÍAS
# =========================
if (!require(pacman)) install.packages("pacman")
pacman::p_load(
tidyverse,   # incluye dplyr, ggplot2, readr
readr,
dplyr,
ggplot2,
janitor,
kableExtra
)
# CARGA DE BASE (HIPO)
base_2023 <- read_delim(
"../input/data/Latinobarometro_2023_Argentina_Csv_esp_v1.csv",
delim = ";"
)
# =========================
# LIMPIEZA COMPLETA
# =========================
base_clean <- base_2023 %>%
select(EDAD, SEXO, S10, S11, P11STGBS.A) %>%
mutate(
# eliminar NS/NR en todas
EDAD = na_if(EDAD, 0),
SEXO = na_if(SEXO, 0),
S10 = na_if(S10, 96),
S10 = na_if(S10, 97),
S10 = na_if(S10, 98),
S10 = na_if(S10, 0),
S11 = na_if(S11, 0),
sat_dem = na_if(P11STGBS.A, 8),
sat_dem = na_if(sat_dem, 0)
) %>%
mutate(
# convertir tipos
SEXO = factor(SEXO, labels = c("Hombre", "Mujer")),
S11 = factor(S11, ordered = TRUE),
sat_dem = factor(sat_dem, ordered = TRUE)
) %>%
drop_na()
#RENOMBRAR VARIABLES
base_clean <- base_clean %>%
rename(
edad = EDAD,
sexo = SEXO,
edad_fin_estudios = S10,
nivel_educativo = S11
)
base_clean <- base_clean %>%
rename(
satisfaccion_democracia = sat_dem
)
base_clean <- base_2023 %>%
select(EDAD, SEXO, S10, S11, P11STGBS.A) %>%
mutate(
satisfaccion_democracia = case_when(
P11STGBS.A %in% c(-1, -2, 0, 8) ~ NA_real_,
TRUE ~ P11STGBS.A
)
) %>%
drop_na(satisfaccion_democracia)
base_clean <- base_clean %>%
mutate(
satisfaccion_democracia = factor(satisfaccion_democracia, ordered = TRUE)
)
base_clean <- base_clean %>%
select(-P11STGBS.A)
datos_satisfaccion_democratica <- base_clean
datos_satisfaccion_democratica <- datos_satisfaccion_democratica %>%
mutate(
edad_fin_estudios = ifelse(edad_fin_estudios < 0, NA, edad_fin_estudios)
) %>%
drop_na()
# =========================
# LIMPIEZA COMPLETA
# =========================
